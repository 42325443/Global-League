{
  "info": {
    "_postman_id": "global-league-management",
    "name": "Global League APIs",
    "description": "Smoke E2E de la API de Global League para CI (Newman). Requiere backend arriba y BD sembrada. Variable: baseUrl. El registro/login fija la cookie de sesion que el resto de requests reutiliza.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "equipoLocalId", "value": "" },
    { "key": "equipoVisitanteId", "value": "" },
    { "key": "torneoId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Registrar organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro responde 201 (creado) o 409 (ya existia)', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  var usuario = pm.response.json().usuario;",
                  "  pm.test('Devuelve el usuario creado', function () {",
                  "    pm.expect(usuario).to.be.an('object');",
                  "    pm.expect(usuario.email).to.eql('juana@global-league.com');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juana\",\n  \"apellido\": \"Lopez\",\n  \"email\": \"juana@global-league.com\",\n  \"password\": \"Secreta123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/registro", "host": ["{{baseUrl}}"], "path": ["auth", "registro"] }
          }
        },
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso con cookie de sesion', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.usuario).to.be.an('object');",
                  "  pm.expect(json.usuario.email).to.eql('juana@global-league.com');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juana@global-league.com\",\n  \"password\": \"Secreta123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET Sesion actual (requiere auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La cookie de sesion es valida', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().usuario.email).to.eql('juana@global-league.com');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
